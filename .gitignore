# ---------------------------------------------------------------------------
# Local trust material. The lab CA and the poia.local certificate are
# generated by run.sh on first start and never belong in the repository.
# ---------------------------------------------------------------------------
certs/
private/

# Runtime configuration and data
.env
app/data/
downstream/data/
*.db
# ...except the raw evidence stores whose package checksums cover them.
# These hold only synthetic fixture rows; every human-study table is empty.
!experiments/human_pilot/protocol_enforcement/**/raw/protocol_evidence.db
.poia_experiments.csv
migration_backup/

# Python / virtualenv
.venv/
__pycache__/
*.pyc
dist/

# Editor and operating-system artefacts
.DS_Store
.idea/
*.swp
_to_delete/
*.preopt
*.prewords
*.prefix
*.premodelfix
*.prehmacfix

# ---------------------------------------------------------------------------
# Human-subject records are not released. The manuscript makes no confirmatory
# human-behavioural claim, and the consent obtained does not cover open
# publication of participant-level responses. The blank study instruments in
# experiments/human_pilot/templates/ are included; the responses are not.
# ---------------------------------------------------------------------------
experiments/human_study/
experiments/human_pilot/**/participants.csv
experiments/poia_run_fresh_*/

# Working directories that hold no released evidence
tamarin/results/
experiments/track_e/raw/
PoIA_Extended/
PoIA_Journal/
