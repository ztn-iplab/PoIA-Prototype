      case case_2
      by contradiction /* from formulas */
    qed
  next
    case Issue
    solve( (last(#t))  ∥
           (∃ #s. (NewVersion( ~n, v ) @ #s) ∧ (¬(last(#s))) ∧ (#s < #t)) )
      case case_1
      solve( Current( ~n, v ) ▶₁ #t )
        case Execute_case_1
        by contradiction /* from formulas */
      next
        case Execute_case_2
        by contradiction /* from formulas */
      next
        case Issue_case_1
        by contradiction /* from formulas */
      next
        case Issue_case_2
        by contradiction /* from formulas */
      next
        case Mutate
        by contradiction /* from formulas */
      next
        case Resource
        by contradiction /* from formulas */
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case Mutate
    solve( (last(#t))  ∥
           (∃ #s. (NewVersion( ~n, v ) @ #s) ∧ (¬(last(#s))) ∧ (#s < #t)) )
      case case_1
      solve( Current( ~n, v ) ▶₀ #t )
        case Execute_case_1
        by contradiction /* from formulas */
      next
        case Execute_case_2
        by contradiction /* from formulas */
      next
        case Issue_case_1
        by contradiction /* from formulas */
      next
        case Issue_case_2
        by contradiction /* from formulas */
      next
        case Mutate
        by contradiction /* from formulas */
      next
        case Resource
        by contradiction /* from formulas */
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  qed
qed

lemma key_secrecy [heuristic=o "oracle", reuse, use_induction]:
  all-traces
  "∀ u sk #i #j. ((KeyCreated( u, sk ) @ #i) ∧ (K( sk ) @ #j)) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ u sk #i #j. (KeyCreated( u, sk ) @ #i) ∧ (K( sk ) @ #j)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( !KU( ~n.1 ) @ #vk )
    case Issue
    by solve( (#vr.4, 0) ~~> (#vk, 0) )
  next
    case Mutate
    by solve( (#vr.1, 0) ~~> (#vk, 0) )
  qed
qed

lemma approval_origin [heuristic=o "oracle", reuse]:
  all-traces
  "∀ u n a r v d #s.
    (Approved( u, n, a, r, v, d ) @ #s) ⇒
    (∃ #i. (Issued( u, n, a, r, v, d ) @ #i) ∧ (#i < #s))"
/*
guarded formula characterizing all counter-examples:
"∃ u n a r v d #s.
  (Approved( u, n, a, r, v, d ) @ #s)
 ∧
  ∀ #i. (Issued( u, n, a, r, v, d ) @ #i) ⇒ ¬(#i < #s)"
*/
simplify
solve( !Key( u, sk ) ▶₀ #s )
  case Key
  solve( !IssuedRecord( ~n, n.2, a, r, v, d ) ▶₁ #s )
    case Issue_case_1
    by contradiction /* from formulas */
  next
    case Issue_case_2
    by contradiction /* from formulas */
  qed
qed

lemma signature_origin [heuristic=o "oracle", reuse, use_induction]:
  all-traces
  "∀ u sk n a r v d #k #t.
    ((KeyCreated( u, sk ) @ #k) ∧ (K( sign(<u, n, a, r, v, d>, sk) ) @ #t)) ⇒
    (∃ #s. (Approved( u, n, a, r, v, d ) @ #s) ∧ (#s < #t))"
/*
guarded formula characterizing all counter-examples:
"∃ u sk n a r v d #k #t.
  (KeyCreated( u, sk ) @ #k) ∧ (K( sign(<u, n, a, r, v, d>, sk) ) @ #t)
 ∧
  ∀ #s. (Approved( u, n, a, r, v, d ) @ #s) ⇒ ¬(#s < #t)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (last(#t))  ∥
         (∃ #s.
           (Approved( ~n, n.2, a, r, v, d ) @ #s) ∧ (¬(last(#s))) ∧ (#s < #t)) )
    case case_1
    solve( !KU( sign(<~n, n.2, a, r, v, d>, ~n.1) ) @ #vk )
      case Approve_case_1
      by contradiction /* from formulas */
    next
      case Approve_case_2
      by contradiction /* from formulas */
    next
      case Issue
      by contradiction /* impossible chain */
    next
      case Mutate
      by contradiction /* impossible chain */
    next
      case c_sign
      solve( !KU( ~n.1 ) @ #vk.2 )
        case Issue
        by solve( (#vr.4, 0) ~~> (#vk.1, 0) )
      next
        case Mutate
        by solve( (#vr.1, 0) ~~> (#vk.1, 0) )
      qed
    qed
  next
    case case_2
    by contradiction /* from formulas */
  qed
qed

lemma causal_authorization [heuristic=o "oracle", use_induction]:
  all-traces
  "∀ u n a r v d #e.
    (Executed( u, n, a, r, v, d ) @ #e) ⇒
    (∃ #i #s.
      (((Issued( u, n, a, r, v, d ) @ #i) ∧
        (Approved( u, n, a, r, v, d ) @ #s)) ∧
       (#i < #s)) ∧
      (#s < #e))"
/*
guarded formula characterizing all counter-examples:
"∃ u n a r v d #e.
  (Executed( u, n, a, r, v, d ) @ #e)
 ∧
  ∀ #i #s.
   (Issued( u, n, a, r, v, d ) @ #i) ∧ (Approved( u, n, a, r, v, d ) @ #s)
  ⇒
   ((¬(#i < #s)) ∨ (¬(#s < #e)))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (last(#e))  ∥
         (∃ #i #s.
           (Issued( u, n, a, ~n.1, v, h(c) ) @ #i) ∧
           (Approved( u, n, a, ~n.1, v, h(c) ) @ #s)
          ∧
           (¬(last(#s))) ∧ (¬(last(#i))) ∧ (#i < #s) ∧ (#s < #e)) )
    case case_1
    solve( !Key( u, sk ) ▶₀ #e )
      case Key
      by contradiction /* from formulas */
    qed
  next
    case case_2
    by contradiction /* from formulas */
  qed
qed

lemma retired_version_not_read [hide_lemma=version_origin,
                                hide_lemma=resource_origin, heuristic=o "oracle", reuse, use_induction]:
  all-traces
  "∀ r v w #m #t.
    (((Mutated( r, v, w ) @ #m) ∧ (ReadVersion( r, v ) @ #t)) ∧ (#m < #t)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ r v w #m #t.
  (Mutated( r, v, w ) @ #m) ∧ (ReadVersion( r, v ) @ #t) ∧ #m < #t"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( ReadVersion( r, v ) @ #t )
    case Execute
    solve( Current( r, v ) ▶₂ #t )
      case Execute_case_1
      by contradiction /* cyclic */
    next
      case Execute_case_2
      by contradiction /* cyclic */
    next
      case Issue_case_1
      by contradiction /* cyclic */
    next
      case Issue_case_2
      by contradiction /* cyclic */
    next
      case Mutate
      solve( Current( r, ~n ) ▶₀ #m )
        case Execute
        by contradiction /* cyclic */
      next
        case Issue
        by contradiction /* cyclic */
      qed
    next
      case Resource
      by contradiction /* cyclic */
    qed
  next
    case Issue
    solve( Current( r, v ) ▶₁ #t )
      case Execute_case_1
      by contradiction /* cyclic */
    next
      case Execute_case_2
      by contradiction /* cyclic */
    next
      case Issue_case_1
      by contradiction /* cyclic */
    next
      case Issue_case_2
      by contradiction /* cyclic */
    next
      case Mutate
      solve( Current( r, ~n ) ▶₀ #m )
        case Execute
        by contradiction /* cyclic */
      next
        case Issue
        by contradiction /* cyclic */
      qed
    next
      case Resource
      by contradiction /* cyclic */
    qed
  next
    case Mutate
    solve( Current( r, v ) ▶₀ #t )
      case Execute_case_1
      by contradiction /* cyclic */
    next
      case Execute_case_2
      by contradiction /* cyclic */
    next
      case Issue_case_1
      by contradiction /* cyclic */
    next
      case Issue_case_2
      by contradiction /* cyclic */
    next
      case Mutate
      solve( Current( r, ~n ) ▶₀ #m )
        case Execute
        by contradiction /* cyclic */
      next
        case Issue
        by contradiction /* cyclic */
      next
        case Mutate
        by contradiction /* cyclic */
      qed
    next
      case Resource
      by contradiction /* cyclic */
    qed
  qed
qed

lemma no_execution_after_version_change [heuristic=o "oracle",
                                         use_induction]:
  all-traces
  "∀ u n a r v d w #i #m #e.
    (((((Issued( u, n, a, r, v, d ) @ #i) ∧ (Mutated( r, v, w ) @ #m)) ∧
       (Executed( u, n, a, r, v, d ) @ #e)) ∧
      (#i < #m)) ∧
     (#m < #e)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ u n a r v d w #i #m #e.
  (Issued( u, n, a, r, v, d ) @ #i) ∧
  (Mutated( r, v, w ) @ #m) ∧
  (Executed( u, n, a, r, v, d ) @ #e)
 ∧
  (#i < #m) ∧ (#m < #e)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  by contradiction /* from formulas */
qed

