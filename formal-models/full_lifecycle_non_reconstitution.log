theory PoIA_FullLifecycle

begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

/* looping facts with injective instances: Current/1 */

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

restriction AtMostOneAdversarialAction:
  "∀ a b #i #j.
    ((AdversarialAction( a ) @ #i) ∧ (AdversarialAction( b ) @ #j)) ⇒
    (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ a b #i #j.
    ((AdversarialAction( a ) @ #i) ∧ (AdversarialAction( b ) @ #j)) ⇒
    (#i = #j)"
  */

rule (modulo E) Init_Signer:
   [ Fr( sk ) ] --[ InitSigner( ) ]-> [ !SignKey( sk ), !SignPub( pk(sk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Init_Capture:
   [ Fr( content ), Fr( v0 ) ]
  --[ Captured( content ), InitReferent( v0, content ) ]->
   [ !TrueCaptured( content ), !Referent( v0, content ), Current( v0 ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Mutate_Referent:
   [ Current( v ), Fr( content2 ), Fr( v2 ) ]
  --[ MutateReferent( v, v2, content2 ), AdversarialAction( 'mutate' ) ]->
   [ !Referent( v2, content2 ), Current( v2 ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Commit_Intent:
   [ Current( v ), !Referent( v, content ) ]
  --[ Committed( v, content, h(content) ) ]->
   [ !CommittedDigest( h(content) ), Current( v ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) RootA_Honest:
   [ !CommittedDigest( d ) ] --[ RootADigest( d ) ]-> [ DigestA( d ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) RootB_Honest:
   [ !CommittedDigest( d ) ] --[ RootBDigest( d ) ]-> [ DigestB( d ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Compromise_RootA:
   [ In( evil ) ]
  --[ RootACompromisedWith( evil ), AdversarialAction( 'rootA' ) ]->
   [ DigestA( evil ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Compromise_RootB:
   [ In( evil ) ]
  --[ RootBCompromisedWith( evil ), AdversarialAction( 'rootB' ) ]->
   [ DigestB( evil ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_K2:
   [ !SignKey( sk ), DigestA( dA ), DigestB( dB ) ]
  --[ Eq( dA, dB ), Signed( dA ) ]->
   [ Out( <dA, sign(dA, sk)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Execute_RSI:
   [ !SignPub( pk ), In( <d, sig> ), Current( v ), !Referent( v, content ) ]
  --[
  Eq( verify(sig, d, pk), true ), Eq( h(content), d ),
  Executed( d, content )
  ]->
   [ Current( v ) ]

  // loop breaker: [2]
  /*
  rule (modulo AC) Execute_RSI:
     [ !SignPub( pk ), In( <d, sig> ), Current( v ), !Referent( v, content ) ]
    --[ Eq( z, true ), Eq( h(content), d ), Executed( d, content ) ]->
     [ Current( v ) ]
    variants (modulo AC)
    1. d     = d.7
       pk    = pk.7
       sig   = sig.7
       z     = verify(sig.7, d.7, pk.7)
    
    2. d     = x.7
       pk    = pk(x.8)
       sig   = sign(x.7, x.8)
       z     = true
    // loop breaker: [2]
  */

rule (modulo E) Sign_K1:
   [ !SignKey( sk ), DigestA( dA ) ]
  --[ SignedWeak( dA ) ]->
   [ Out( <dA, sign(dA, sk)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Execute_Legacy:
   [ !SignPub( pk ), In( <d, sig> ) ]
  --[ Eq( verify(sig, d, pk), true ), ExecutedWeak( d ) ]->
   [ ]

  /*
  rule (modulo AC) Execute_Legacy:
     [ !SignPub( pk ), In( <d, sig> ) ]
    --[ Eq( z, true ), ExecutedWeak( d ) ]->
     [ ]
    variants (modulo AC)
    1. d     = d.5
       pk    = pk.5
       sig   = sig.5
       z     = verify(sig.5, d.5, pk.5)
    
    2. d     = x.5
       pk    = pk(x.6)
       sig   = sign(x.5, x.6)
       z     = true
  */

lemma pipeline_executable:
  exists-trace "∃ d content #i. Executed( d, content ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ d content #i. (Executed( d, content ) @ #i)"
*/
simplify
solve( !SignPub( pk(x) ) ▶₀ #i )
  case Init_Signer
  solve( !Referent( v, content ) ▶₃ #i )
    case Init_Capture
    solve( !KU( sign(h(~n.1), ~n) ) @ #vk.2 )
      case Sign_K1_case_1
      solve( Current( ~n.2 ) ▶₂ #i )
        case Commit_Intent
        solve( Current( ~n.2 ) ▶₀ #vr.5 )
          case Commit_Intent
          solve( Current( ~n.2 ) ▶₀ #vr.6 )
            case Commit_Intent
            solve( Current( ~n.2 ) ▶₀ #vr.7 )
              case Commit_Intent
              solve( Current( ~n.2 ) ▶₀ #vr.8 )
                case Commit_Intent
                solve( Current( ~n.2 ) ▶₀ #vr.9 )
                  case Commit_Intent
                  solve( Current( ~n.2 ) ▶₀ #vr.10 )
                    case Commit_Intent
                    solve( Current( ~n.2 ) ▶₀ #vr.11 )
                      case Init_Capture
                      solve( Current( ~n.2 ) ▶₀ #vr.12 )
                        case Init_Capture
                        solve( !KU( h(~n.1) ) @ #vk.2 )
                          case Sign_K1
                          solve( Current( ~n.2 ) ▶₀ #vr.13 )
                            case Init_Capture
                            SOLVED // trace found
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma full_lifecycle_non_reconstitution:
  all-traces
  "∀ d content2 #e.
    (Executed( d, content2 ) @ #e) ⇒
    (∃ v content0 #c.
      (Committed( v, content0, d ) @ #c) ∧ (content0 = content2))"
/*
guarded formula characterizing all counter-examples:
"∃ d content2 #e.
  (Executed( d, content2 ) @ #e)
 ∧
  ∀ v content0 #c.
   (Committed( v, content0, d ) @ #c) ∧ (content0 = content2) ⇒ ⊥"
*/
simplify
solve( !SignPub( pk(x) ) ▶₀ #e )
  case Init_Signer
  solve( !Referent( v, content2 ) ▶₃ #e )
    case Init_Capture
    solve( !KU( sign(h(~n.1), ~n) ) @ #vk.2 )
      case Sign_K1_case_1
      by contradiction /* from formulas */
    next
      case Sign_K1_case_2
      solve( !KU( h(~n.1) ) @ #vk.2 )
        case Sign_K1
        by contradiction /* from formulas */
      next
        case Sign_K2
        by contradiction /* from formulas */
      next
        case c_h
        by solve( !KU( ~n.1 ) @ #vk.3 )
      qed
    next
      case Sign_K2_case_1
      by contradiction /* from formulas */
    next
      case Sign_K2_case_2
      by contradiction /* from formulas */
    next
      case Sign_K2_case_3
      by contradiction /* from formulas */
    next
      case c_sign
      by solve( !KU( ~n ) @ #vk.3 )
    qed
  next
    case Mutate_Referent
    solve( !KU( sign(h(~n.1), ~n) ) @ #vk.2 )
      case Sign_K1
      by contradiction /* from formulas */
    next
      case Sign_K2
      by contradiction /* from formulas */
    next
      case c_sign
      by solve( !KU( ~n ) @ #vk.3 )
    qed
  qed
qed

lemma weak_pipeline_vulnerable_to_single_compromise:
  exists-trace
  "∃ v content evil #c #r #s #e.
    ((((((Committed( v, content, h(content) ) @ #c) ∧
         (RootACompromisedWith( evil ) @ #r)) ∧
        (SignedWeak( evil ) @ #s)) ∧
       (ExecutedWeak( evil ) @ #e)) ∧
      (#r < #s)) ∧
     (#s < #e)) ∧
    (¬(evil = h(content)))"
/*
guarded formula characterizing all satisfying traces:
"∃ v content evil #c #r #s #e.
  (Committed( v, content, h(content) ) @ #c) ∧
  (RootACompromisedWith( evil ) @ #r) ∧
  (SignedWeak( evil ) @ #s) ∧
  (ExecutedWeak( evil ) @ #e)
 ∧
  (#r < #s) ∧ (#s < #e) ∧ (¬(evil = h(content)))"
*/
simplify
solve( !Referent( v, content ) ▶₁ #c )
  case Init_Capture
  solve( !SignKey( sk ) ▶₀ #s )
    case Init_Signer
    solve( DigestA( evil ) ▶₁ #s )
      case Compromise_RootA
      solve( !SignPub( pk(x) ) ▶₀ #e )
        case Init_Signer
        solve( !KU( sign(evil, ~n.2) ) @ #vk.2 )
          case Sign_K1_case_2
          solve( Current( ~n ) ▶₀ #c )
            case Init_Capture
            SOLVED // trace found
          qed
        qed
      qed
    qed
  qed
qed

